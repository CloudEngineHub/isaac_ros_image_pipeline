<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cvcuda_conversions</name>
  <version>5.0.0</version>
  <description>
    Header-only converter between sensor_msgs/Image or tensor_msgs/ExperimentalTensor
    (backed by rosidl::Buffer) and CV-CUDA nvcv::Tensor, riding on the registered
    rosidl::Buffer backend. Modeled after ros2/rosidl_buffer_backends torch_conversions.
  </description>

  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>cuda_buffer</depend>
  <depend>isaac_ros_tensor_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tensor_msgs</depend>
  <depend>cvcuda0-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
